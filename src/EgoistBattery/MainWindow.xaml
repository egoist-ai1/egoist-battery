<Window x:Class="EgoistBattery.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:EgoistBattery.Controls" xmlns:vm="clr-namespace:EgoistBattery.ViewModels"
    Title="Egoist Battery — заряд устройств" Width="1100" Height="780" MinWidth="720" MinHeight="480" Background="{DynamicResource Background}" Foreground="{DynamicResource Text}"
    FontFamily="{DynamicResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" WindowStartupLocation="CenterScreen" ShowActivated="False">
    <Window.Resources>
        <!-- Раздел списка. -->
        <DataTemplate DataType="{x:Type vm:GroupHeader}">
            <StackPanel Orientation="Horizontal" Margin="4,24,4,10">
                <TextBlock Style="{StaticResource Caps}" Text="{Binding Title}"/>
                <TextBlock Style="{StaticResource Caps}" Text="  ·  "/>
                <TextBlock Style="{StaticResource Caps}" Text="{Binding Count}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Строка устройства: значок, имя и состояние, шкала, число, действия. -->
        <DataTemplate DataType="{x:Type vm:DeviceRow}">
            <Border x:Name="Row" c:Motion.Reveal="True" c:Motion.Delay="{Binding RevealDelay}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,14,4,14" Background="Transparent" AutomationProperties.Name="{Binding Spoken}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/><ColumnDefinition Width="1.15*" MinWidth="180"/><ColumnDefinition Width="1.4*" MinWidth="120" MaxWidth="460"/><ColumnDefinition Width="132"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="22" Foreground="{Binding ToneBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        <StackPanel x:Name="Names" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <c:LevelRuler x:Name="Ruler" Grid.Column="2" Height="22" VerticalAlignment="Center" Margin="0,0,24,0" Cells="{Binding RulerCells}" Solid="{Binding RulerSolid}" Interval="{Binding RulerInterval}" Fill="{Binding ToneBrush}" Spectrum="{Binding UseSpectrum}" Track="{DynamicResource Track}" Delay="{Binding RevealDelay}"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="Bolt" Style="{StaticResource Glyph}" Text="&#xE945;" Foreground="{DynamicResource Accent}" FontSize="17" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <c:CountText x:Name="Numeral" Value="{Binding NumeralValue}" Fallback="{Binding NumeralText}" Delay="{Binding RevealDelay}" FontFamily="{DynamicResource DataFont}" FontSize="{Binding NumeralSize}" FontWeight="SemiBold" Foreground="{Binding ToneBrush}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="TrayButton" Style="{StaticResource IconButton}" Visibility="{Binding CanShowTrayIcon, Converter={StaticResource BoolVisibility}}" Command="{Binding DataContext.ToggleTrayDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" ToolTip="{Binding TrayHint}" AutomationProperties.Name="{Binding TrayHint}">
                                <TextBlock x:Name="TrayIcon" Style="{StaticResource Glyph}" Text="{Binding TrayGlyph}" Foreground="{DynamicResource Text}"/>
                            </Button>
                            <Button x:Name="IgnoreButton" Style="{StaticResource IconButton}" Visibility="Collapsed" Command="{Binding DataContext.IgnoreDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" ToolTip="Скрыть устройство из списка" AutomationProperties.Name="{Binding IgnoreName}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Command="{Binding DataContext.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Как получено показание" AutomationProperties.Name="{Binding ExpandName}">
                                <TextBlock x:Name="Chevron" Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="12" Foreground="{DynamicResource Muted}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="Details" Grid.Row="1" Margin="44,12,0,2" Visibility="Collapsed" c:Motion.Reveal="True">
                        <StackPanel>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Meta}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SourceLine}" FontFamily="{DynamicResource DataFont}" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TimeLine}" FontFamily="{DynamicResource DataFont}" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface}"/></Trigger>
                <DataTrigger Binding="{Binding IsMeasured}" Value="False">
                    <Setter TargetName="Ruler" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Numeral" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="IgnoreButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Names" Property="Grid.ColumnSpan" Value="2"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Muted}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCharging}" Value="True"><Setter TargetName="Bolt" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding TrayShown}" Value="False"><Setter TargetName="TrayIcon" Property="Foreground" Value="{DynamicResource Faint}"/></DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Details" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                    <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Text}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="RootContent" Background="{DynamicResource Background}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Верхняя панель: название, разделы, обновление. -->
        <Border Padding="28,10,28,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid MaxWidth="1000">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="EGOIST BATTERY" FontFamily="{DynamicResource DataFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,36,6"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TabButton}" Content="Устройства" c:Selection.IsSelected="{Binding DevicesPage}" Command="{Binding SelectPageCommand}" CommandParameter="devices"/>
                    <Button Style="{StaticResource TabButton}" Content="Настройки" c:Selection.IsSelected="{Binding SettingsPage}" Command="{Binding SelectPageCommand}" CommandParameter="settings"/>
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0,0,0,8" Padding="14,7" AutomationProperties.Name="Обновить данные устройств">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SpinIcon" Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0"><TextBlock.RenderTransform><RotateTransform x:Name="Spin"/></TextBlock.RenderTransform></TextBlock>
                        <TextBlock Text="Обновить" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" FontSize="13.5"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Линия обновления: бежит, пока идёт чтение. -->
        <Rectangle Grid.Row="1" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="Scan" X="-1"/></LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#00C6F24E" Offset="0"/><GradientStop Color="#FFC6F24E" Offset="0.5"/><GradientStop Color="#00C6F24E" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Scan" Storyboard.TargetProperty="X" From="-1" To="1" Duration="0:0:1.1" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers>
        </Rectangle>

        <Grid Grid.Row="2">
            <!-- Устройства -->
            <Grid x:Name="DevicesPageRoot" MaxWidth="1000" Margin="28,26,28,0" Visibility="{Binding DevicesPage, Converter={StaticResource BoolVisibility}}" c:Motion.Reveal="True">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" FontFamily="{DynamicResource DisplayFont}" FontSize="30" FontWeight="Normal"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding Status}" FontFamily="{DynamicResource DataFont}" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Style="{StaticResource Caps}" Text="{Binding PageIndex}" VerticalAlignment="Top" Margin="16,8,0,0"/>
                </Grid>
                <Border Grid.Row="1" Margin="0,16,0,0" Background="{DynamicResource AmberWash}" BorderBrush="{DynamicResource Amber}" BorderThickness="1" CornerRadius="{DynamicResource RadiusM}" Padding="14,10">
                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Amber}" Margin="0,1,10,0" VerticalAlignment="Top"/><TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Amber}" TextWrapping="Wrap" MaxWidth="860"/></StackPanel>
                </Border>
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SegButton}" Content="Подключённые" c:Selection.IsSelected="{Binding FilterConnected}" Command="{Binding SelectFilterCommand}" CommandParameter="connected"/>
                        <Button Style="{StaticResource SegButton}" Content="С батареей" c:Selection.IsSelected="{Binding FilterBattery}" Command="{Binding SelectFilterCommand}" CommandParameter="battery"/>
                        <Button Style="{StaticResource SegButton}" Content="Все сохранённые" c:Selection.IsSelected="{Binding FilterAll}" Command="{Binding SelectFilterCommand}" CommandParameter="all"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="240" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по имени, типу и подключению" AutomationProperties.Name="Поиск устройств"/>
                </Grid>
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <ScrollViewer x:Name="DeviceViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False"/>
                    </ScrollViewer>
                    <!-- Первое чтение: контуры строк, чтобы окно не было пустым. -->
                    <StackPanel Visibility="{Binding Skeleton, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Top" Margin="0,16,0,0">
                        <StackPanel.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></EventTrigger></StackPanel.Triggers>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,16"><Grid><Border Width="260" Height="14" Background="{DynamicResource Raised}" CornerRadius="3" HorizontalAlignment="Left"/><Border Width="90" Height="22" Background="{DynamicResource Raised}" CornerRadius="3" HorizontalAlignment="Right"/></Grid></Border>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,16"><Grid><Border Width="200" Height="14" Background="{DynamicResource Raised}" CornerRadius="3" HorizontalAlignment="Left"/><Border Width="90" Height="22" Background="{DynamicResource Raised}" CornerRadius="3" HorizontalAlignment="Right"/></Grid></Border>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,16"><Grid><Border Width="230" Height="14" Background="{DynamicResource Raised}" CornerRadius="3" HorizontalAlignment="Left"/><Border Width="90" Height="22" Background="{DynamicResource Raised}" CornerRadius="3" HorizontalAlignment="Right"/></Grid></Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}" MaxWidth="460" Margin="0,0,0,40" c:Motion.Reveal="True">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE772;" FontSize="34" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyTitle}" FontFamily="{DynamicResource DisplayFont}" FontSize="20" TextAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding EmptyHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
                        <Button Content="Сбросить фильтры" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="{Binding CanResetFilters, Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Настройки -->
            <ScrollViewer x:Name="SettingsViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,24" Margin="28,26,20,0" Visibility="{Binding SettingsPage, Converter={StaticResource BoolVisibility}}" c:Motion.Reveal="True">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{Binding PageTitle}" FontFamily="{DynamicResource DisplayFont}" FontSize="30" FontWeight="Normal"/>
                        <TextBlock Style="{StaticResource Caps}" Text="{Binding PageIndex}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Caps}" Text="ОБНОВЛЕНИЕ И УВЕДОМЛЕНИЯ" Margin="4,26,0,12"/>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Экономный режим" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,4,0,0" Text="В трее заряд проверяется раз в минуту или реже. Подключение USB и Bluetooth обновляется по событиям, радиоприёмники проверяются при следующем чтении."/></StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding EcoMode}" VerticalAlignment="Center" AutomationProperties.Name="Экономный режим"/></Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Интервал чтения" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0" Text="Как часто обновляются данные, пока окно открыто."/></StackPanel>
                            <Slider Grid.Column="1" Width="260" Value="{Binding RefreshSeconds}" Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Интервал чтения в секундах"/>
                            <TextBlock Grid.Column="2" FontFamily="{DynamicResource DataFont}" FontSize="15" TextAlignment="Right" VerticalAlignment="Center"><Run Text="{Binding RefreshSeconds, Mode=OneWay}"/><Run Text=" с"/></TextBlock></Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Предупреждать о низком заряде" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0" Text="Системное уведомление не чаще раза в 30 минут для каждого устройства."/></StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Notifications}" VerticalAlignment="Center" AutomationProperties.Name="Предупреждать о низком заряде"/></Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="4,16" IsEnabled="{Binding Notifications}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Порог предупреждения" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0" Text="Ниже этого уровня значок и шкала становятся янтарными."/></StackPanel>
                            <Slider Grid.Column="1" Width="260" Value="{Binding LowThreshold}" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Порог низкого заряда в процентах"/>
                            <TextBlock Grid.Column="2" FontFamily="{DynamicResource DataFont}" FontSize="15" TextAlignment="Right" VerticalAlignment="Center"><Run Text="{Binding LowThreshold, Mode=OneWay}"/><Run Text="%"/></TextBlock></Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Caps}" Text="ЗНАЧОК РЯДОМ С ЧАСАМИ" Margin="4,36,0,12"/>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="4,18">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Text="Один значок. Он показывает DualSense, а если его нет — устройство с наименьшим зарядом; другое устройство можно закрепить булавкой в его строке. Наведите курсор — панель покажет все подключённые устройства с зарядом. Двойной щелчок открывает окно, правый — меню."/>
                            <WrapPanel Margin="0,18,0,0" x:Name="TrayLegend"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Caps}" Text="СКРЫТЫЕ УСТРОЙСТВА" Margin="4,36,0,12"/>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="4,16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock FontWeight="SemiBold"><Run Text="Скрыто устройств: "/><Run Text="{Binding IgnoredCount, Mode=OneWay}"/></TextBlock><TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,4,0,0" Text="Старые и ненужные устройства скрываются крестиком в их строке. Новые устройства появляются сами."/></StackPanel>
                            <Button Grid.Column="1" Content="Показать снова" Command="{Binding RestoreIgnoredCommand}" VerticalAlignment="Center" IsEnabled="{Binding HasIgnored}"/></Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Caps}" Text="ОТКУДА БЕРУТСЯ ДАННЫЕ" Margin="4,36,0,12"/>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="4,18">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Text="Программа читает заряд DualSense и DualShock 4, мышей и клавиатур Logitech через HID++, стандартную службу батареи Bluetooth LE, свойства батареи Windows, XInput и батарею компьютера. Она не изменяет режим контроллера и настройки устройств."/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" Text="Заряд через USB-приёмники зависит от протокола производителя. Если устройство не передаёт батарею, это указано в списке. Подключённый кабель сам по себе не означает 100% заряда."/>
                            <Button Content="Сохранить сведения об устройствах…" Click="ExportClick" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="4,22,0,0">
                        <TextBlock Text="{Binding VersionText}" FontFamily="{DynamicResource DataFont}" FontSize="12" Foreground="{DynamicResource Faint}"/>
                        <TextBlock Text=" · работает локально · закрытие окна оставляет мониторинг в трее" FontFamily="{DynamicResource DataFont}" FontSize="12" Foreground="{DynamicResource Faint}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
