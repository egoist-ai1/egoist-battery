<Window x:Class="EgoistBattery.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Egoist Battery — заряд устройств" Width="1190" Height="840" MinWidth="760" MinHeight="480" Background="{DynamicResource Background}" Foreground="{DynamicResource Text}"
    FontFamily="{DynamicResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" WindowStartupLocation="CenterScreen" ShowActivated="False">
    <Grid x:Name="RootContent" Background="{DynamicResource Background}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="20,30,20,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="EGOIST" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
                    <TextBlock Text="Battery" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Заряд под рукой" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,34"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Content="Устройства" Command="{Binding SelectPageCommand}" CommandParameter="devices" Margin="0,0,0,10" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="devices"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="#183529"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="Настройки" Command="{Binding SelectPageCommand}" CommandParameter="settings" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="settings"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="#183529"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Border Background="#183529" CornerRadius="8" Padding="12" Margin="0,0,0,16"><TextBlock Text="Работает локально" Foreground="#B7F5CC" FontSize="12"/></Border>
                    <TextBlock Text="Версия 1.0.0" Foreground="{DynamicResource Muted}" FontSize="12"/>
                    <TextBlock Text="Закрытие окна оставляет&#x0a;мониторинг в трее." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="30,28,24,20" MaxWidth="1480">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="20,0,0,0" AutomationProperties.Name="Обновить данные устройств"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource Accent}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#F6C879" Margin="0,0,0,10"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel>
            <Grid Grid.Row="2" Visibility="{Binding DevicesPage, Converter={StaticResource BoolVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,20">
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding CompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="На связи" Foreground="{DynamicResource Muted}" FontSize="13" MinHeight="34" TextWrapping="Wrap"/><TextBlock Text="{Binding ConnectedCount}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Grid.Column="1" Background="{DynamicResource Surface}" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="С уровнем заряда" Foreground="{DynamicResource Muted}" FontSize="13" MinHeight="34" TextWrapping="Wrap"/><TextBlock Text="{Binding MeasuredCount}" Foreground="{DynamicResource Accent}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="Без процента" Foreground="{DynamicResource Muted}" FontSize="13" MinHeight="34" TextWrapping="Wrap"/><TextBlock Text="{Binding UnknownCount}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,0,0,18">
                    <Button Content="Подключённые" Command="{Binding SelectFilterCommand}" CommandParameter="connected" Margin="0,0,8,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="connected"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="С батареей" Command="{Binding SelectFilterCommand}" CommandParameter="battery" Margin="0,0,8,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="battery"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="Все сохранённые" Command="{Binding SelectFilterCommand}" CommandParameter="all" Margin="0,0,14,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="all"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Grid Width="214" Margin="0,0,0,8"><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по имени, типу и подключению" AutomationProperties.Name="Поиск устройств"/><TextBlock Text="Поиск устройств…" Foreground="{DynamicResource Muted}" Margin="13,11,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                </WrapPanel>
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="DeviceViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0" SizeChanged="DeviceViewportSizeChanged" ScrollChanged="DeviceViewportScrollChanged">
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,16,16" MinHeight="274">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Accent}" FontSize="26" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="22" MinHeight="44" ToolTip="{Binding Name}"/><TextBlock FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"><Run Text="{Binding Kind, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Transport, Mode=OneWay}"/></TextBlock></StackPanel>
                                            <Button Grid.Column="2" Content="{Binding TrayGlyph}" IsEnabled="{Binding CanShowTrayIcon}" FontFamily="Segoe UI" Padding="8,8" FontSize="16" Margin="10,0,0,0" Command="{Binding DataContext.ToggleTrayDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" ToolTip="{Binding TrayHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding TrayHint}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Level}" FontSize="38" FontWeight="SemiBold" Foreground="{Binding Accent}" Margin="0,20,0,8"/>
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Background="{DynamicResource Raised}" Foreground="{Binding Accent}" BorderThickness="0"/>
                                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding State}" FontSize="13" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Connection}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="8,0,0,0"/></Grid>
                                        <TextBlock Text="{Binding Quality}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,9,0,0"/>
                                        <Expander Header="Как получено показание" Margin="0,14,0,0"><StackPanel Margin="4,10,0,0"><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13"/><TextBlock Text="{Binding Source}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,10,0,0"/><TextBlock Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel></Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}" MaxWidth="460">
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="Подключите устройство или выберите другой фильтр. Программа повторит чтение автоматически." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SettingsPage, Converter={StaticResource BoolVisibility}}">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="24" Margin="0,0,0,16"><StackPanel>
                        <TextBlock Text="Обновление и уведомления" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
                        <CheckBox Content="Минимальная нагрузка в фоне" IsChecked="{Binding EcoMode}" Margin="0,0,0,10"/>
                        <TextBlock Text="В трее заряд проверяется раз в минуту или реже. Подключение USB и Bluetooth обновляется по событиям. Связь с устройством через радиоприёмник проверяется при следующем чтении." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,20"/>
                        <TextBlock><Run Text="Интервал при открытом окне: "/><Run Text="{Binding RefreshSeconds}"/><Run Text=" с"/></TextBlock>
                        <Slider Value="{Binding RefreshSeconds}" Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,12,0,22" AutomationProperties.Name="Интервал чтения в секундах"/>
                        <CheckBox Content="Предупреждать о низком заряде" IsChecked="{Binding Notifications}" Margin="0,0,0,20"/>
                        <TextBlock><Run Text="Порог предупреждения: "/><Run Text="{Binding LowThreshold}"/><Run Text="%"/></TextBlock>
                        <Slider Value="{Binding LowThreshold}" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,12,0,0" AutomationProperties.Name="Порог низкого заряда в процентах"/>
                    </StackPanel></Border>
                    <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="24" Margin="0,0,0,16"><StackPanel>
                        <TextBlock Text="Значок рядом с часами" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <TextBlock Text="Каждое подключённое устройство с батареей получает отдельный значок. При отключении значок исчезает; при подключении появляется снова. Кнопка в карточке позволяет скрыть отдельное устройство." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Text="Число — переданный устройством процент. Знак «+» обозначает интервал: например, 10+ у DualSense означает 10–19%. Наведение показывает имя, полный уровень и состояние. Двойной щелчок открывает окно; правый щелчок — настройки и выход. Вопросительный знак означает, что процент недоступен." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
                    </StackPanel></Border>
                    <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="24"><StackPanel>
                        <TextBlock Text="Откуда берутся данные" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <TextBlock Text="Программа читает заряд DualSense и DualShock 4, мышей и клавиатур Logitech через HID++, стандартную службу батареи Bluetooth LE, свойства батареи Windows, XInput и батарею компьютера. Она не изменяет режим контроллера и настройки устройств." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Text="Заряд через USB-приёмники зависит от протокола производителя. Если устройство не предоставляет батарею, это указано в карточке. Подключённый кабель сам по себе не означает 100% заряда." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,18"/>
                        <Button Content="Сохранить сведения об устройствах…" Click="ExportClick" HorizontalAlignment="Left"/>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,15,0,0" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>
